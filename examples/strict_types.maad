type Point is record
    var x : integer; var y : integer
end
type Coordinate is record
    var x : integer; var y : integer
end

var p1 : Point is new Point(
    x is 10, y is 20
)
var p2 : Coordinate is new Point(
    x is 30, y is 40
)

routine PrintPoint(p : Point) is
    print p.x, p.y
end

routine Main() is
    PrintPoint(p1)
    // These would be type errors:
    // PrintPoint(p2)
    // p1 := p2
end