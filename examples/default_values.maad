type int is integer

routine main() : integer is
    var n1 : integer
    var n2 : int // a synonym to “integer”
    var r  : real
    var b  : boolean
    var a  : array[1] integer
    
    print n1, n2 // 0, 0
    print r      // 0.0
    print b      // false
    print a      // Object at 0x121345

    return 0
end
